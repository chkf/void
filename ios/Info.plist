<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleDevelopmentRegion</key><string>zh_CN</string>
  <key>CFBundleDisplayName</key><string>void</string>
  <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
  <key>LSRequiresIPhoneOS</key><true/>
  <key>UILaunchScreen</key><dict/>
  <key>UIApplicationSceneManifest</key><dict><key>UIApplicationSupportsMultipleScenes</key><false/></dict>
  <key>UIFileSharingEnabled</key><true/>
  <key>LSSupportsOpeningDocumentsInPlace</key><true/>
  <key>NSPhotoLibraryUsageDescription</key><string>让获准的项目读取你选择的照片和视频。</string>
  <key>NSPhotoLibraryAddUsageDescription</key><string>将项目生成的图片和视频保存到你的照片图库。</string>
  <key>NSCameraUsageDescription</key><string>按你在项目中的操作显示预览、拍照或录像。</string>
  <key>NSMicrophoneUsageDescription</key><string>为你开启的录音或录像录制声音。</string>
  <key>NSLocationWhenInUseUsageDescription</key><string>向前台运行且获准的项目提供位置与航向。</string>
  <key>NSCalendarsFullAccessUsageDescription</key><string>为你授权的项目查询或修改日历事件。</string>
  <key>NSCalendarsWriteOnlyAccessUsageDescription</key><string>将项目中创建的事件添加到日历。</string>
  <key>NSRemindersFullAccessUsageDescription</key><string>为你授权的项目管理提醒及列表。</string>
  <key>NSContactsUsageDescription</key><string>按你的选择查询或更新联系人。</string>
  <key>NSBluetoothAlwaysUsageDescription</key><string>在前台发现并连接你要使用的蓝牙配件。</string>
  <key>NFCReaderUsageDescription</key><string>读取或写入你主动靠近的 NFC 标签。</string>
  <key>NSHealthShareUsageDescription</key><string>让获准的项目读取你选择的健康数据类型。</string>
  <key>NSHealthUpdateUsageDescription</key><string>将你同意的健康样本写入健康 App。</string>
  <key>NSHomeKitUsageDescription</key><string>按你的操作查看家庭配件、修改特征或运行场景。</string>
  <key>NSFaceIDUsageDescription</key><string>使用面容 ID 验证你在项目中发起的操作。</string>
  <key>NSLocalNetworkUsageDescription</key><string>连接你授权的项目在清单中声明的本地网络服务。</string>
  <key>NSAppTransportSecurity</key><dict><key>NSAllowsLocalNetworking</key><true/></dict>
  <key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>
</dict></plist>
